# Copy to agentic/.env (gitignored). Read by every .runs/<id>/pi launch.

# OpenAI-compatible base URL of the model server (llama-swap). NOT the /v1/models URL.
ESPERWARE_LLM_BASE_URL=http://cortex:9999/v1
ESPERWARE_LLM_API_KEY=none

# Model id sent to the server. Switch this per arm (baseline vs LoRA entries in llama-swap).
ESPERWARE_MODEL=qwen38-27b-q4km-256k
ESPERWARE_CONTEXT_WINDOW=262144
ESPERWARE_MAX_TOKENS=16384

# Which esperware MCP endpoint the agent gets: rw (all tools) or ro (read-only tools).
ESPERWARE_MCP_ACCESS=rw
