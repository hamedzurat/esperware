set shell := ["bash", "-euo", "pipefail", "-c"]

image := "esperware-dataset"

default: dataset

# Build codes/<name>/ per dataset.toml inside the pinned container (see Containerfile).
# `--all` or `<profile>...` override dataset.toml; `-p <glob>` limits programs.
dataset *args:
    podman image exists {{image}} || just image
    podman run --rm --network=none -v "$PWD":/work -w /work {{image}} python3 build_dataset.py {{args}}

# Same build with this machine's compilers, into build/host/. Not reproducible elsewhere.
host *args:
    python3 build_dataset.py --out build/host {{args}}

# (Re)build the container image
image:
    podman build -t {{image}} - < Containerfile

clean:
    if [ -e build ]; then /usr/bin/trash-put -- build; fi
