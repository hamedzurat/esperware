set shell := ["bash", "-euo", "pipefail", "-c"]

default: build

build:
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p build
    for src in *.c; do
      [ -e "$src" ] || continue
      stem="${src%.c}"
      gcc -O1 -fno-inline -fno-stack-protector -no-pie -g "$src" -o "build/${stem}.unstripped.elf"
      cp "build/${stem}.unstripped.elf" "build/${stem}.stripped.elf"
      strip --strip-all "build/${stem}.stripped.elf"
      echo "built build/${stem}.unstripped.elf + build/${stem}.stripped.elf (-O1)"
    done

one name:
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p build
    gcc -O1 -fno-inline -fno-stack-protector -no-pie -g "{{name}}.c" -o "build/{{name}}.unstripped.elf"
    cp "build/{{name}}.unstripped.elf" "build/{{name}}.stripped.elf"
    strip --strip-all "build/{{name}}.stripped.elf"
    echo "built build/{{name}}.unstripped.elf + build/{{name}}.stripped.elf (-O1)"

clean:
    if [ -e build ]; then /usr/bin/trash-put -- build; fi
